# Copy to .env (which git ignores) and fill in. Never commit real keys or tokens.
# Every value is read by config/smugmug.php; see the README's configuration table.

# Your application's API key and secret, from https://www.smugmug.com/app/developer.
# The key alone reads public data; the secret signs OAuth 1.0a requests.
SMUGMUG_API_KEY=
SMUGMUG_API_SECRET=

# The account the default connection acts as. Leave both empty to read public data only, or to act for each
# user with SmugMug::withToken() after they sign in.
SMUGMUG_ACCESS_TOKEN=
SMUGMUG_ACCESS_TOKEN_SECRET=

# Where SmugMug sends a user back after they approve your application, or "oob" for a six-digit code.
SMUGMUG_CALLBACK_URL=oob

# Timeouts in seconds.
SMUGMUG_CONNECT_TIMEOUT=10
SMUGMUG_REQUEST_TIMEOUT=30
SMUGMUG_UPLOAD_TIMEOUT=300

# How many times to retry a GET that failed on SmugMug's side. Empty turns retries off.
SMUGMUG_RETRIES=

# Cache GET responses (true or false), in this cache store (empty for the default store).
SMUGMUG_CACHE=false
SMUGMUG_CACHE_STORE=

# A second account, if config/smugmug.php's connections has a "studio" entry (SmugMug::connection('studio')).
# SMUGMUG_STUDIO_API_KEY=
# SMUGMUG_STUDIO_API_SECRET=
# SMUGMUG_STUDIO_ACCESS_TOKEN=
# SMUGMUG_STUDIO_ACCESS_TOKEN_SECRET=
